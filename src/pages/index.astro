---
// =============================================================================
//  PROPUESTA COMERCIAL CONFIDENCIAL — Aldea Quinquén
//  Layout "Presentación Ejecutiva": sidebar fijo + tabs (JS vanilla).
//  Mobile First · Astro + Tailwind CSS. SEO omitido a propósito.
// =============================================================================
import "../styles/global.css";

// --- Índice de navegación (sidebar + barra móvil) ---------------------------
const tabs = [
  { id: "diagnostico", n: "01", label: "Diagnóstico y Contexto" },
  { id: "soluciones",  n: "02", label: "El Sistema (Soluciones)" },
  { id: "ads",         n: "03", label: "Inversión en Ads" },
  { id: "inversion",   n: "04", label: "Inversión y Cronograma" },
];

// --- Datos del embudo (centralizados para edición rápida) -------------------
const modulos = [
  {
    n: "01",
    titulo: "Meta Ads",
    puntos: [
      'Diseñar Arquitectura de Campaña (Ciclones): Campañas en ciclos de 14 días con objetivos de "Conversión", dividido entre Marketing y Remarketing, con 5-8 anuncios activos en total. Inversión recomendada 300-900usd por ciclo.',
      'Copywriting de Respuesta Directa (Método Cialdini): "Atajos mentales" que usa el cerebro para ahorrar esfuerzo al decidir.',
      "Instalar Trazabilidad de Datos (Píxel/API): Integrar el Píxel de Meta y la API de Conversiones con la página web y formularios para educar al algoritmo.",
      "Ejecutar Optimización Periodica (A/B Testing): Monitorear KPI más importantes (CTR, CPC, ROAS, etc) y optimizar.",
      "Implementar Retargeting Secuencial: Crear audiencias personalizadas para Remarketing.",
    ],
    bonus: "Auditoría y corrección de la configuración de Meta. En caso de no existir se realizaría las gestiones como parte del plan.",
  },
  {
    n: "02",
    titulo: "Gestión de Redes Sociales",
    puntos: [
      'Planificar Grilla (Método "Jab, Jab, Jab, Right Hook"): Contenido de Valor + Refutación de Objeciones + Venta.',
      "Edición Profesional de Reels: Edición de 8-12 Reels al mes por postproductora profesional.",
      "Post complementarios: 4-8 Fotos o gráficas de contenido complementario.",
      "Interacciones con otras cuentas: En pos de potenciar el algoritmo, se harán diversas interacciones en otras cuentas como comentar, dar like, etc para que el algoritmo nos premie.",
    ],
    bonus: 'Estrategia centrada en Instagram, pero se puede aplicar gratuitamente contenido "espejo" en Facebook y Tik Tok.',
  },
  {
    n: "03",
    titulo: "Implementación SaaS",
    puntos: [
      "Configuración del CRM: Crear el tablero visual con las etapas optimas del pipeline.",
      "Construir el Filtro de Fricción: Diseñar formularios, Agentes de IA y Automatizaciones que ayuden a filtrar.",
      "Configurar Ruteo de Calendarios (Round Robin): Integrar los calendarios de los corredores para que los leads calificados se distribuyan equitativamente de forma automática.",
      'Redactar y Automatizar Secuencia de Nurturing: Crear workflows con mensajes de "Calentamiento" que el lead recibirá antes de la llamada, post llamada y si es que no llega.',
    ],
    bonus: "Webhook de CAPI para optimizar campañas: En base a los resultados reales las campañas se pueden optimizar.",
  },
  {
    n: "04",
    titulo: "Mantención SaaS",
    puntos: [
      "Auditar Embudos y Workflows: Revisar quincenalmente las tasas de conversión entre cada etapa del embudo.",
      "Optimizar Agentes de IA: Revisar, corregir y actualizar agentes de IA para mejores resultados.",
      "Capacitación y Soporte temprano: Capacitar al personal, resolver dudas puntuales del uso del SaaS, resolver problemas superfluos y contactar a soporte en caso de problemas mayores.",
    ],
    bonus: "Otras Modificaciones y Optimizaciones, conversable según alcance.",
  },
  {
    n: "05",
    titulo: "TikTok Ads",
    puntos: [
      "Similar al caso de Meta Ads, pero con una pequeña variante.",
      "Contenido UGC: Se evaluará el uso de UGC o de simular UGC para el contenido de campañas (máximo 4 extras a Meta).",
      "Segmentación Amplia por Comportamiento: Configurar el targeting apuntando a intereses afines, dejando que el algoritmo busque la demanda latente.",
      "Recepción y tracking de Leads: Estos podrían llegar por múltiples vías, incluyendo configuración de formularios, pixel, etc.",
    ],
    bonus: "Auditoría y corrección de la configuración de TikTok for Business. En caso de no existir se realizaría las gestiones como parte del plan.",
  },
  {
    n: "06",
    titulo: "Asesoría Comercial",
    puntos: [
      'Matriz de Manejo de Objeciones: Redactar un documento con respuestas exactas (Método "Siente, Sentía, Descubrí" de Zig Ziglar) para las objeciones más comunes',
      "Auditar Llamadas Reales (Shadowing): Escuchar 4 grabaciones mensuales de las videollamadas de los corredores. Entrego un desglose técnico de dónde perdieron el control de la venta y qué deben corregir para la siguiente reunión.",
      "Coaching en casos puntuales: Ante desmotivación, falta de resultados u otro se podrá optar por un coaching personalizado. Disponibilidad 1 por semana máximo en total. Sujeto a una necesidad real, no como algo estandar.",
    ],
    bonus: 'Script de Ventas (Método "Línea Recta"): Escribir el guion para la llamada. Estructurado para tomar el control en los primeros 10 segundos, pre-calificar, hacer la presentación del proyecto y pedir el cierre sin titubeos.',
  },
];

// --- Tab 03 · Inversión en Ads (proyección de presupuesto) -------------------
// Cada desplegable tiene "escenarios" (título + puntos + nota) o solo "puntos".
const modulosAds = [
  {
    n: "01",
    titulo: "Meta Ads",
    escenarios: [
      {
        titulo: "1. Escenario Ideal (Máxima Eficiencia - 5% de Conversión)",
        puntos: [
          "Leads necesarios: 2.000 leads mensuales.",
          "CPL Proyectado: $1.500 a $2.000 CLP (posible gracias al alto CTR de tu oferta y el refresco de los ciclones).",
          "Presupuesto Mínimo Requerido: $3.000.000 a $4.000.000 CLP mensuales (Aprox. $3.300 a $4.500 USD).",
        ],
        nota: "Este es el escenario donde todo funciona perfecto, los reels se viralizan y la IA de Meta encuentra rápido tu nicho gracias a la CAPI.",
      },
      {
        titulo: "2. Escenario de Preventivo (Conservador - 3% de Conversión)",
        puntos: [
          "Leads necesarios: 3.333 leads mensuales.",
          "CPL Proyectado: $2.500 a $3.000 CLP (si la competencia sube la puja o algunos creativos del ciclón no traccionan tan bien).",
          "Presupuesto Máximo/Recomendado: $8.300.000 a $10.000.000 CLP mensuales (Aprox. $9.000 a $11.000 USD).",
        ],
        nota: "Este es el presupuesto que salva los resultados si la tasa de conversión sufre fluctuaciones o si el equipo comercial falla en el cierre.",
      },
    ],
  },
  {
    n: "02",
    titulo: "TikTok Ads",
    escenarios: [
      {
        titulo: "1. Escenario Optimista (2.5% de Conversión)",
        puntos: [
          "Leads necesarios: 4.000 leads mensuales.",
          "CPL Proyectado: $1.000 a $1.200 CLP.",
          "Presupuesto Mínimo Requerido: $4.000.000 a $4.800.000 CLP mensuales (Aprox. $4.400 a $5.300 USD).",
        ],
        nota: "Este escenario asume que la IA en SaaS está optimizada y funcionando en perfectas condiciones.",
      },
      {
        titulo: "2. Escenario de Seguridad / Realista (1.5% de Conversión)",
        puntos: [
          "Leads necesarios: 6.666 leads mensuales.",
          "CPL Proyectado: $1.300 a $1.500 CLP.",
          "Presupuesto Máximo/Recomendado: $8.600.000 a $10.000.000 CLP mensuales (Aprox. $9.500 a $11.000 USD).",
        ],
        nota: "Si quieres asegurar tu meta y no depender de que un video se haga viral de casualidad, este es el número real. Vas a necesitar inyectar miles de leads para compensar la baja calidad del tráfico.",
      },
    ],
  },
  {
    n: "03",
    titulo: "Conclusiones iniciales",
    puntos: [
      "De tener que elegir entre uno de los 2, sin duda elegiría Meta Ads. Se proyecta requerir menos leads para llegar al mismo resultado de 100 ventas mensuales.",
      "TikTok Ads puede traer más trafico, pero menos calificado aumentando el costo de los Agentes de IA o el tiempo invertido por el equipo comercial.",
      "No descarto TikTok Ads de plano ya que podemos apuntar a un público más joven y tiene mayor potencial a ser viral.",
      "En caso de utilizar ambos, dividiría el presupuesto de la siguiente forma: 2/3 Meta Ads y 1/3 TikTok Ads.",
    ],
  },
];

// Precios en CLP (netos). tipo "mensual" suma a la mensualidad; "unico" va aparte.
// Un módulo con varias opciones se elige como una sola (se excluyen entre sí).
const precios = [
  { n: "01", item: "Meta Ads", tipo: "mensual", opciones: [{ clp: 550000 }] },
  {
    n: "02",
    item: "Gestión de Redes Sociales",
    tipo: "mensual",
    opciones: [
      { label: "8 Reels + 4 Post", clp: 450000 },
      { label: "12 Reels + 8 Posts", clp: 600000 },
    ],
  },
  { n: "03", item: "Implementación SaaS", tipo: "unico", opciones: [{ clp: 900000 }] },
  { n: "04", item: "Mantención SaaS", tipo: "mensual", opciones: [{ clp: 150000 }] },
  { n: "05", item: "TikTok Ads", tipo: "mensual", opciones: [{ clp: 650000 }] },
  { n: "06", item: "Asesoría Comercial", tipo: "mensual", opciones: [{ clp: 300000 }] },
];
const clp = (n) => "$" + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
const sufijo = (tipo) => (tipo === "mensual" ? "/ mes" : "pago único");

const cronograma = [
  { semana: "Semana 1", hito: "Firma del contrato, pago de honorarios y análisis e investigación del caso." },
  { semana: "Semana 2", hito: "Entrega de la planificación de los servicios contratados y Ajustes según feedback." },
  { semana: "Semanas 3–8", hito: "Implementación y acompañamiento." },
  { semana: "Semanas 9–12", hito: "Análisis y optimización." },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Propuesta Aldea Quinquén | Matías Laporta</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root { font-family: "Inter", ui-sans-serif, system-ui, sans-serif; }
      body { font-family: "Inter", ui-sans-serif, system-ui, sans-serif; }

      /* Estado activo del navegador de tabs (sidebar vs barra móvil) */
      .nav-side.tab-active {
        background: rgba(34, 211, 238, 0.1);
        color: #fff;
        box-shadow: inset 2px 0 0 #22d3ee;
      }
      .nav-side.tab-active .nav-num { color: #22d3ee; }
      .nav-top.tab-active {
        background: #06b6d4;
        color: #0f172a;
        border-color: #06b6d4;
      }

      /* Tarjetas plegables (<details>): oculta el marcador nativo */
      details > summary { list-style: none; }
      details > summary::-webkit-details-marker { display: none; }
    </style>
  </head>

  <body class="min-h-screen bg-[#0f172a] text-slate-300 antialiased">
    <!-- ===================================================================== -->
    <!-- SIDEBAR (FIJO en lg+)                                                   -->
    <!-- ===================================================================== -->
    <aside
      class="hidden lg:flex lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 lg:flex-col z-30 border-r border-slate-800/80 bg-[#0b0f19]"
    >
      <!-- Encabezado de la propuesta -->
      <div class="border-b border-slate-800/80 px-6 py-7">
        <a href="https://matiaslaporta.com/" target="_blank" rel="noopener noreferrer">
          <img src="/logo-ml-inv.png" alt="Matías Laporta" class="mb-5 h-12 w-auto transition hover:opacity-80" />
        </a>
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-yellow-400"></span>
          <span class="text-[11px] font-semibold tracking-widest text-slate-500 uppercase">
            Propuesta confidencial
          </span>
        </div>
        <h2 class="mt-3 text-lg font-bold leading-tight text-white">
          Propuesta <span class="text-yellow-400">Aldea Quinquén</span>
        </h2>
      </div>

      <!-- Navegación -->
      <nav class="flex-1 overflow-y-auto px-3 py-5">
        <ul class="space-y-1">
          {
            tabs.map((t) => (
              <li>
                <button
                  type="button"
                  data-tab={t.id}
                  class="nav-side group flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-medium text-slate-400 transition hover:bg-slate-800/50 hover:text-white"
                >
                  <span class="nav-num font-mono text-xs text-slate-600 tabular-nums transition">
                    {t.n}
                  </span>
                  <span>{t.label}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Footer del sidebar -->
      <div class="border-t border-slate-800/80 px-6 py-5">
        <a
          href="https://calendar.app.google/mTu5R8CYQ7A2BKYZ7"
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full rounded-lg bg-yellow-400 px-4 py-3 text-center text-sm font-semibold text-slate-900 transition hover:bg-yellow-300"
        >
          Agendar Kick-off
        </a>
      </div>
    </aside>

    <!-- ===================================================================== -->
    <!-- BARRA SUPERIOR MÓVIL (lg:hidden)                                        -->
    <!-- ===================================================================== -->
    <header class="lg:hidden sticky top-0 z-30 border-b border-slate-800/80 bg-[#0b0f19]/95 backdrop-blur">
      <div class="flex items-center justify-between px-4 py-4">
        <div class="flex items-center gap-2.5">
          <a href="https://matiaslaporta.com/" target="_blank" rel="noopener noreferrer">
            <img src="/logo-ml-inv.png" alt="Matías Laporta" class="h-7 w-auto transition hover:opacity-80" />
          </a>
          <h2 class="text-base font-bold text-white">
            Propuesta <span class="text-yellow-400">Aldea Quinquén</span>
          </h2>
        </div>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Abrir menú"
          class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-700 text-slate-200 transition hover:bg-slate-800/50"
        >
          <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
          </svg>
          <svg id="menu-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <!-- Menú desplegable -->
      <div id="mobile-menu" class="hidden border-t border-slate-800/80 px-4 py-4">
        <div class="flex items-center gap-2 px-1">
          <span class="h-2 w-2 rounded-full bg-yellow-400" />
          <p class="text-[11px] font-semibold tracking-widest text-slate-500 uppercase">
            Propuesta confidencial
          </p>
        </div>
        <ul class="mt-3 space-y-1.5">
          {
            tabs.map((t) => (
              <li>
                <button
                  type="button"
                  data-tab={t.id}
                  class="nav-top flex w-full items-center gap-3 rounded-lg border border-slate-800 px-3 py-2.5 text-left text-sm font-medium text-slate-300 transition"
                >
                  <span class="font-mono text-xs text-slate-600 tabular-nums">{t.n}</span>
                  {t.label}
                </button>
              </li>
            ))
          }
        </ul>
        <a
          href="https://calendar.app.google/mTu5R8CYQ7A2BKYZ7"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 block w-full rounded-lg bg-yellow-400 px-4 py-3 text-center text-sm font-semibold text-slate-900 transition hover:bg-yellow-300"
        >
          Agendar Kick-off
        </a>
      </div>
    </header>

    <!-- ===================================================================== -->
    <!-- ÁREA DE CONTENIDO (scrolleable)                                         -->
    <!-- ===================================================================== -->
    <!-- Fondo de nodos animados (solo visible en tabs Resumen e Inversión) -->
    <canvas
      id="bg-nodes"
      class="pointer-events-none fixed top-0 left-0 z-0 hidden"
      aria-hidden="true"
    ></canvas>

    <main id="content-scroll" class="relative z-10 lg:ml-72 lg:h-screen lg:overflow-y-auto">
      <div class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 py-14 sm:px-10 sm:py-16 lg:px-16 lg:py-24">

        <!-- ============================ TAB 01 ============================ -->
        <!-- DIAGNÓSTICO Y CONTEXTO (Hero + PAS + Autoridad + Comparativa)      -->
        <section data-panel="diagnostico">

          <!-- ----- Bloque A: El Gancho (Hero) ----- -->
          <div>
            <p class="text-sm font-semibold tracking-widest text-cyan-400 uppercase">
              Propuesta de estrategia 360° de prospección para Aldea Quinquén
            </p>
            <h1 class="mt-6 max-w-[calc(48rem+1.625rem)] text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">
              Validar
              <span class="text-yellow-400">un nuevo paradigma</span>
              para el Real Estate chileno.
            </h1>
            <p class="mt-4 max-w-[calc(48rem+1.625rem)] text-lg leading-relaxed text-slate-400 lg:text-xl">
              El desafío de la venta inmobiliaria en caliente - máximo 72hrs
            </p>
            <div class="mt-10 flex flex-col gap-4 sm:flex-row">
              <button
                type="button"
                data-tab="soluciones"
                class="inline-flex items-center justify-center rounded-lg bg-cyan-500 px-7 py-3.5 text-sm font-semibold text-slate-900 transition hover:bg-cyan-400"
              >
                Ver el sistema
              </button>
              <button
                type="button"
                data-tab="inversion"
                class="inline-flex items-center justify-center rounded-lg border border-slate-700 px-7 py-3.5 text-sm font-semibold text-slate-200 transition hover:border-slate-500 hover:bg-slate-800/50"
              >
                Inversión y cronograma
              </button>
            </div>
          </div>

          <!-- ----- Bloque B: Diagnóstico ----- -->
          <div class="mt-10 border-t border-slate-800/60 py-10">
            <p class="text-sm font-semibold tracking-widest text-cyan-400 uppercase">
              El Diagnóstico
            </p>

            <div class="mt-8 space-y-10">
              <div class="border-l-2 border-cyan-500/40 pl-5 sm:pl-6">
                <p class="max-w-3xl text-base leading-relaxed text-slate-400 lg:text-lg">
                  <strong class="font-semibold text-white">AMSAC no está lanzando un loteo más</strong>,
                  están democratizando el acceso a parcelas con un modelo atípico off-grid.
                </p>
              </div>

              <div class="border-l-2 border-cyan-500/40 pl-5 sm:pl-6">
                <p class="max-w-3xl text-base leading-relaxed text-slate-400 lg:text-lg">
                  El verdadero reto para alcanzar esa agresiva meta de unas 100 ventas mensuales
                  <strong class="font-semibold text-white">no es el producto, sino el comportamiento de
                  compra:</strong> necesitamos transformar la venta inmobiliaria consultiva y lenta en una
                  experiencia visceral y rápida de máximo 72 horas.
                </p>
              </div>

              <div class="border-l-2 border-yellow-400/50 pl-5 sm:pl-6">
                <p class="max-w-3xl text-base leading-relaxed text-slate-400 lg:text-lg">
                  Para ello,
                  <strong class="font-semibold text-yellow-400">es imperativo diseñar una estructura que
                  integre el marketing con el área comercial</strong>, con tal de que trabajen en
                  sincronía y retroalimentándose correctamente.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- ============================ TAB 02 ============================ -->
        <section data-panel="soluciones" class="hidden">
          <p class="text-sm font-semibold tracking-widest text-cyan-400 uppercase">
            El Sistema
          </p>
          <h2 class="mt-5 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl lg:whitespace-nowrap">
            5 pilares para un embudo <span class="text-yellow-400">predecible</span>.
          </h2>
          <div class="mt-12 space-y-4">
            {
              modulos.map((m) => (
                <details class="group rounded-xl border border-slate-800 bg-[#0b0f19]/60 transition duration-300 hover:border-yellow-400/40 hover:shadow-[0_0_35px_-8px_rgba(250,204,21,0.45)] open:border-yellow-400/30">
                  <summary class="flex cursor-pointer items-center gap-4 p-6 sm:gap-6">
                    <span class="font-mono text-2xl font-bold text-cyan-400/80 tabular-nums">
                      {m.n}
                    </span>
                    <h3 class="flex-1 text-lg font-semibold text-white lg:text-xl">{m.titulo}</h3>
                    <svg
                      class="h-5 w-5 shrink-0 text-slate-500 transition-transform duration-300 group-open:rotate-180"
                      viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"
                    >
                      <path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <div class="px-6 pb-6">
                    <ul class="space-y-2.5 border-t border-slate-800/80 pt-5">
                      {m.puntos.map((p) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-slate-400 lg:text-base">
                          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-400/70" />
                          <span>{p}</span>
                        </li>
                      ))}
                    </ul>
                    <p class="mt-5 inline-flex flex-wrap items-center gap-2 rounded-lg border border-yellow-400/20 bg-yellow-400/5 px-3 py-1.5 text-sm">
                      <span class="text-xs font-bold tracking-wide text-yellow-400 uppercase">Bonus</span>
                      <span class="text-slate-300">{m.bonus}</span>
                    </p>
                  </div>
                </details>
              ))
            }
          </div>
        </section>

        <!-- ============================ TAB 03 ============================ -->
        <!-- INVERSIÓN EN ADS (proyección de presupuesto por plataforma)       -->
        <section data-panel="ads" class="hidden">
          <p class="text-sm font-semibold tracking-widest text-cyan-400 uppercase">
            Background y Proyección
          </p>
          <h2 class="mt-5 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
            <span class="text-yellow-400">Diesel</span> para el sistema de prospección.
          </h2>
