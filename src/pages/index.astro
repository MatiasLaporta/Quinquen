            <!-- Resumen (misma altura que "Arma tu plan") -->
            <div class="flex min-w-0 flex-col rounded-xl border border-yellow-400/50 bg-gradient-to-b from-yellow-400/10 to-[#0b0f19]/60 p-5 transition duration-300 hover:border-cyan-400/60 hover:shadow-[0_0_35px_-8px_rgba(34,211,238,0.45)] sm:p-7">
              <h3 class="text-base font-semibold text-yellow-400">Tu inversión</h3>
